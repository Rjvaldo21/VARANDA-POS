# VARANDA-POS Frontend Environment Variables

# API Configuration - Update port if Django runs on different port
VITE_API_BASE_URL=http://localhost:8000/api

# Alternative API URLs for different environments
# VITE_API_BASE_URL=http://localhost:8001/api  
# VITE_API_BASE_URL=https://your-production-api.com/api

# Development mode
NODE_ENV=development

# Application settings
VITE_APP_NAME=VARANDA POS
VITE_APP_VERSION=1.0.0

# Debug settings - Set to true for development debugging
VITE_DEBUG=true

# Request timeout (in milliseconds)
VITE_API_TIMEOUT=30000