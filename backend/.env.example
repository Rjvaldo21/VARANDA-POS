# VARANDA-POS Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Django Configuration
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com,api.yourdomain.com

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/varanda_pos
# Alternative for SQLite (development only):
# DATABASE_URL=sqlite:///./db.sqlite3

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False

# Cloud Storage Configuration (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=varanda-pos-media
AWS_S3_REGION_NAME=us-east-1
USE_S3=True

# Alternative: DigitalOcean Spaces
# DO_SPACES_ACCESS_KEY_ID=your-do-access-key
# DO_SPACES_SECRET_ACCESS_KEY=your-do-secret-key
# DO_SPACES_BUCKET_NAME=varanda-pos-media
# DO_SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# USE_DO_SPACES=True

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# JWT Token Settings
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Monitoring & Logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=INFO

# API Rate Limiting
RATE_LIMIT_ENABLE=True
RATE_LIMIT_PER_MINUTE=60